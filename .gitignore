.pnp.js

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Payload's generated type cache — regenerated by `next dev`/`next build` or
# `payload generate:types` from payload.config.ts; committing it would mean
# committing a generated artefact (CLAUDE.md §8.2), and it churns on every
# field change.
payload-types.ts

# Environment and secrets — never commit
.env
.env.*
!.env.example

# Test artefacts
coverage/
playwright-report/
test-results/
blob-report/
*.lcov

# Local media and database volumes
media/
uploads/
.postgres-data/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# The handoff archive — the extracted folder is tracked instead
*.zip
