# .env.example — copy to .env and fill in. Never commit .env (see .gitignore).
# Validated at boot by apps/web/lib/env.ts; a missing or malformed value fails fast
# rather than surfacing later as a confusing connection or auth error.

# Postgres connection string. Matches docker-compose.yml's default credentials.
# Host port 5433 (not Postgres's usual 5432) — see docker-compose.yml's header
# comment for why.
DATABASE_URL=postgres://diary:diary@localhost:5433/diary

# Symmetric secret Payload uses to sign auth tokens and encrypt values at rest.
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Origin the diary client fetches media derivatives from (the local disk adapter's
# public origin in development; the media bucket's public origin in production).
MEDIA_ORIGIN=http://localhost:3000

# Origin the bespoke admin is served at, and the origin every emailed password-reset
# link is built against. Never derived from a request's Host header — a link built from
# one is a link an attacker can point at their own machine (apps/web/lib/env.ts).
ADMIN_ORIGIN=http://localhost:3000
