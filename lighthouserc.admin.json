{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/admin/sign-in",
        "http://localhost:3000/admin/sign-in/code",
        "http://localhost:3000/admin/reset"
      ],
      "numberOfRuns": 5,
      "startServerCommand": "npm run build -w apps/web && npm run start -w apps/web -- --port 3000",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 180000,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage",
        "formFactor": "desktop",
        "screenEmulation": { "mobile": false, "width": 1440, "height": 900, "deviceScaleFactor": 1, "disabled": false }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/admin/.*",
          "aggregationMethod": "median",
          "assertions": {
            "http-status-code": ["error", { "minScore": 1 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 327680 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports/admin"
    }
  }
}
