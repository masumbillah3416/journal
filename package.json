{
  "name": "travel-diary",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force && tsc -p apps/web --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "dev": "npm run dev -w apps/web",
    "test": "vitest",
    "test:unit": "vitest run --project unit --project unit-dom --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --passWithNoTests --coverage",
    "test:e2e": "playwright test e2e/smoke.spec.ts e2e/book.spec.ts e2e/flip.spec.ts e2e/layout.spec.ts e2e/chrome.spec.ts e2e/pages.spec.ts e2e/notes.spec.ts e2e/frames.spec.ts e2e/about.spec.ts e2e/imageWindow.spec.ts e2e/serverWindow.spec.ts e2e/routing.spec.ts e2e/gallery.spec.ts e2e/mobile.spec.ts e2e/signIn.spec.ts e2e/codeStep.spec.ts e2e/reset.spec.ts e2e/signInJourney.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:visual:container": "docker compose run --rm visual",
    "test:visual:container:update": "docker compose run --rm visual-update",
    "test:visual:container:update:all": "docker compose run --rm visual-update-all",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:perf": "node scripts/run-lighthouse.mjs lighthouserc.json lighthouserc.book.json lighthouserc.admin.json",
    "verify": "npm run typecheck && npm run lint && npm run test:unit",
    "verify:full": "npm run verify && npm run test:integration:coverage",
    "db:migrate": "npm run db:migrate -w apps/web",
    "db:migrate:down": "npm run db:migrate:down -w apps/web",
    "db:seed": "npm run db:seed -w apps/web",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.4"
  }
}
