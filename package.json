{
  "name": "travel-diary",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc --build --force && tsc -p apps/web --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "verify": "npm run typecheck && npm run lint && npm run test:unit",
    "verify:full": "npm run verify && npm run test:integration",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.4"
  }
}
